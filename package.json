{
  "name": "ai-writing-assistant",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:backend": "pnpm --filter backend dev",
    "dev:extension": "pnpm --filter extension dev",
    "build": "pnpm --filter shared build && pnpm --filter extension build",
    "verify": "node scripts/verify.mjs",
    "verify:autonomous": "node scripts/verify-autonomous.mjs",
    "verify:autonomous-api": "node scripts/verify-autonomous-api.mjs",
    "test": "pnpm --filter backend test && pnpm --filter extension test",
    "typecheck": "pnpm --filter extension typecheck",
    "verify:rls": "node scripts/verify-rls.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:drop": "node scripts/verify-drop.mjs",
    "verify:paywall": "node scripts/verify-paywall.mjs",
    "verify:all": "pnpm typecheck && pnpm test && pnpm verify:rls && pnpm verify:ui && pnpm verify:drop && pnpm verify:docs",
    "verify:prod": "bash scripts/verify-prod.sh",
    "probe:grounding": "node scripts/probe-grounding.mjs"
  },
  "devDependencies": {
    "playwright": "^1.49.0",
    "typescript": "^5.6.0"
  },
  "packageManager": "pnpm@11.20.0"
}
